# Copy to .env.local and fill in as you work through README.md setup.
# In production, set every one of these in Vercel → Project → Settings → Environment Variables.

# Site — the canonical URL (no trailing slash). http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the browser

# Stripe — Developers → API keys / Products / Webhooks
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=                    # price_... for the $47/mo subscription
STRIPE_WEBHOOK_SECRET=              # whsec_... (from `stripe listen` locally)

# Resend — API key + a verified from-address
RESEND_API_KEY=
RESEND_FROM="The November Window <access@yourdomain.com>"

# Mux — Settings → API Access Tokens / Webhooks
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
